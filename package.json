{
    "name": "lir",
    "private": true,
    "version": "1.0.0",
    "main": "main.cjs",
    "type": "module",
    "scripts": {
        "dev": "vite --port=3000 --host=0.0.0.0",
        "build": "vite build",
        "preview": "vite preview",
        "electron:dev": "npm run build && electron .",
        "electron:start": "npm run build && electron .",
        "electron:build": "vite build && electron-builder",
        "clean": "rm -rf dist server.js",
        "lint": "tsc --noEmit"
    },
    "build": {
        "appId": "com.anticvalley.lir",
        "productName": "Lir",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "main.cjs",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "public/assets/img",
                "to": "assets/img",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "public/assets/img/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Lir",
            "installerIcon": "public/assets/img/icon.ico",
            "uninstallerIcon": "public/assets/img/icon.ico"
        }
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.1",
        "lucide-react": "^0.546.0",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "vite": "^8.3.0",
        "express": "^4.21.2",
        "dotenv": "^17.2.3",
        "motion": "^12.23.24"
    },
    "devDependencies": {
        "@types/node": "^22.14.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "autoprefixer": "^10.4.21",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.21.0",
        "typescript": "^7.0.2",
        "@types/express": "^4.17.21"
    }
}
